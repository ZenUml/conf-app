# Developer-specific configuration
# Copy this file to .env.forge.local and fill in your values

# Your Forge environment name
FORGE_ENV=your-env-name

# Your Atlassian site URL
ATLASSIAN_SITE=your-site.atlassian.net

# Optional: a Connect key of your own, so this environment can be installed on a
# site that already has another environment of the same app (Confluence allows
# one install per Connect key). Register the environment in
# functions/utils/devConnectKeys.ts and build dist/ with the same value:
#   CONNECT_KEY_OVERRIDE=<key> pnpm build:lite
# See docs/reference/dev-connect-key.md.
# CONNECT_KEY_OVERRIDE=com.zenuml.confluence-addon-lite-yourname
