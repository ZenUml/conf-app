{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "vue",
    "vitest",
    "promise"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "error"
  },
  "env": {
    "browser": true,
    "es2022": true
  },
  "options": {
    "reportUnusedDisableDirectives": "warn"
  },
  "globals": {
    "mxUtils": "readonly",
    "mxCodec": "readonly",
    "mxGraphModel": "readonly",
    "mxClient": "readonly",
    "Graph": "readonly"
  },
  "ignorePatterns": [
    "dist",
    "public/drawio",
    "node_modules",
    "**/*.d.ts"
  ],
  "rules": {
    "typescript/no-explicit-any": "off",
    "typescript/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_"
      }
    ],
    "typescript/ban-ts-comment": "warn",
    "typescript/no-unused-expressions": "warn",
    "typescript/no-this-alias": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-unsafe-function-type": "warn",
    "no-empty": "warn",
    "prefer-const": "warn",
    "vue/no-reserved-component-names": "warn",
    "vue/no-deprecated-destroyed-lifecycle": "error",
    "vue/prefer-import-from-vue": "error",
    "accessor-pairs": "warn",
    "import/no-named-as-default": "warn",
    "import/no-unassigned-import": "warn",
    "max-classes-per-file": "warn",
    "max-depth": "warn",
    "no-control-regex": "warn",
    "no-else-return": "warn",
    "no-inner-declarations": "warn",
    "no-lonely-if": "warn",
    "no-loop-func": "warn",
    "no-new": "warn",
    "no-redeclare": "warn",
    "no-throw-literal": "warn",
    "no-unmodified-loop-condition": "warn",
    "no-unsafe-optional-chaining": "warn",
    "no-useless-constructor": "warn",
    "no-useless-escape": "warn",
    "no-useless-return": "warn",
    "no-warning-comments": "warn",
    "oxc/branches-sharing-code": "warn",
    "oxc/no-accumulating-spread": "warn",
    "oxc/no-map-spread": "warn",
    "preserve-caught-error": "warn",
    "promise/always-return": "warn",
    "promise/no-multiple-resolved": "warn",
    "promise/no-promise-in-callback": "warn",
    "radix": "warn",
    "typescript/ban-types": "warn",
    "typescript/no-extraneous-class": "warn",
    "unicorn/escape-case": "warn",
    "unicorn/new-for-builtins": "warn",
    "unicorn/no-array-fill-with-reference-type": "warn",
    "unicorn/no-array-reverse": "warn",
    "unicorn/no-hex-escape": "warn",
    "unicorn/no-immediate-mutation": "warn",
    "unicorn/no-lonely-if": "warn",
    "unicorn/no-new-array": "warn",
    "unicorn/no-object-as-default-parameter": "warn",
    "unicorn/no-single-promise-in-promise-methods": "warn",
    "unicorn/no-this-assignment": "warn",
    "unicorn/no-typeof-undefined": "warn",
    "unicorn/no-useless-fallback-in-spread": "warn",
    "unicorn/no-useless-promise-resolve-reject": "warn",
    "unicorn/no-useless-spread": "warn",
    "unicorn/no-useless-switch-case": "warn",
    "unicorn/prefer-array-find": "warn",
    "unicorn/prefer-array-some": "warn",
    "unicorn/prefer-at": "warn",
    "unicorn/prefer-blob-reading-methods": "warn",
    "unicorn/prefer-dom-node-remove": "warn",
    "unicorn/prefer-import-meta-properties": "warn",
    "unicorn/prefer-math-trunc": "warn",
    "unicorn/prefer-native-coercion-functions": "warn",
    "unicorn/prefer-number-coercion": "warn",
    "unicorn/prefer-regexp-test": "warn",
    "unicorn/prefer-set-has": "warn",
    "unicorn/prefer-single-call": "warn",
    "unicorn/prefer-string-slice": "warn",
    "unicorn/prefer-string-starts-ends-with": "warn",
    "unicorn/prefer-type-error": "warn",
    "unicorn/require-post-message-target-origin": "warn",
    "vitest/expect-expect": "warn",
    "vitest/no-commented-out-tests": "warn",
    "vitest/require-to-throw-message": "warn",
    "eqeqeq": "off",
    "import/max-dependencies": "off",
    "import/no-named-as-default-member": "off",
    "max-lines": "off",
    "max-lines-per-function": "off",
    "no-await-in-loop": "off",
    "no-inline-comments": "off",
    "no-negated-condition": "off",
    "no-promise-executor-return": "off",
    "no-shadow": "off",
    "no-underscore-dangle": "off",
    "require-await": "off",
    "require-unicode-regexp": "off",
    "sort-vars": "off",
    "typescript/prefer-ts-expect-error": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/explicit-length-check": "off",
    "unicorn/no-array-callback-reference": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/no-negated-condition": "off",
    "unicorn/no-useless-undefined": "off",
    "unicorn/prefer-add-event-listener": "off",
    "unicorn/prefer-code-point": "off",
    "unicorn/prefer-dom-node-append": "off",
    "unicorn/prefer-dom-node-dataset": "off",
    "unicorn/prefer-query-selector": "off",
    "unicorn/prefer-string-replace-all": "off",
    "unicorn/prefer-top-level-await": "off",
    "vitest/no-conditional-expect": "off",
    "vitest/no-conditional-in-test": "off",
    "vitest/require-mock-type-parameters": "off",
    "vitest/valid-expect": "off"
  }
}
