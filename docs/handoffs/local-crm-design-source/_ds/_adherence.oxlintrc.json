{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "client-profiles/design_handoff_client_profile_cards/reference/**",
              "components/Button/**",
              "components/TabSwitcher/**",
              "components/TitleInput/**",
              "debugbar-redesign.jsx",
              "preview/**",
              "ui_kits/diagram-editor/**",
              "ui_kits/homepage-feed/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Fira Code))/i]",
        "message": "Font not provided by the design system. Available: Fira Code."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|disabled|onClick|type|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, children, disabled, onClick, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|outline|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'outline' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabSwitcherTab'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|dot|bg|fg|key|ref|className|style|children)$/]",
        "message": "<TabSwitcherTab> doesn't accept that prop. Declared props: id, label, dot, bg, fg."
      },
      {
        "selector": "JSXOpeningElement[name.name='TitleInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|label|placeholder|key|ref|className|style|children)$/]",
        "message": "<TitleInput> doesn't accept that prop. Declared props: value, onChange, label, placeholder."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Button": {
        "replaces": []
      },
      "TabSwitcherTab": {
        "replaces": []
      },
      "TitleInput": {
