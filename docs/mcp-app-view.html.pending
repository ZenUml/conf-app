<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ZenUML diagram</title>
  </head>
  <body>
    <!-- The MCP Apps view (functions/agent-link/oauth/mcpApps.ts serves this
         file's built output as the ui://zenuml/diagram resource body). It is a
         normal Vite entry, so the hashed script reference below is written by
         the build and always matches the bundle actually deployed. -->
    <div id="app"></div>
    <script type="module" src="/src/mcp-app-view.ts"></script>
  </body>
</html>
