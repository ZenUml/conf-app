{
  "name": "forge-console",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm run dev:server\" \"pnpm run dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite --port 3457",
    "build": "vite build && tsc -p tsconfig.server.json",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "autoprefixer": "^10.5.4",
    "concurrently": "^8.2.2",
    "pinia": "^3.0.4",
    "postcss": "^8.5.27",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^2.1.9",
    "vue": "^3.5.42"
  }
}
