    "react-dd-menu": "^2.0.2",
    "react-file-download": "^0.3.5"
  },
  "postcss": {
    "plugins": {
      "tailwindcss": {},
      "autoprefixer": {}
    }
  },
  "browserslist": [
    "last 2 years"
  ],
  "engines": {
    "node": ">=22"
  },
  "volta": {
    "node": "22.22.3"
  },
  "pnpm": {
    "overrides": {
      "local-crm>react": "19.2.8",
      "local-crm>react-dom": "19.2.8",
      "react-dom@19.2.8>react": "19.2.8"
    },
    "ignoredBuiltDependencies": [],
    "onlyBuiltDependencies": [
      "@forge/cli",
      "cloudflared",
      "core-js",
      "esbuild",
      "keytar"
    ]
  }
}
