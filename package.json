    "jsdom": "^23.2.0",
    "rollup-plugin-visualizer": "^6.0.11",
    "storybook": "^10.6.0",
    "tailwind-scrollbar": "^3.1.0",
    "typescript-eslint": "^8.69.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^2.1.9",
    "vue-tsc": "^1.8.27",
    "wrangler": "^4.128.0"
  },
  "resolutions": {
    "wrap-ansi": "7.0.0",
