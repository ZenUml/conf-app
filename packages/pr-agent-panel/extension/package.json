    "@wxt-dev/module-vue": "^1.0.3",
    "jsdom": "^26.0.0",
    "typescript": "^5.9.0",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.2.0",
    "wxt": "^0.21.4"
  }
}
