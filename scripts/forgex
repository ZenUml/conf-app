#!/bin/bash
BASE_DIR="$(dirname "$0")/.."
ENV_FILE="$BASE_DIR/.env.forge"
LOCAL_FILE="$BASE_DIR/.env.forge.local"

load_env() {
  local file=$1
  echo "Loading: $file"
  while IFS='=' read -r key value; do
    [[ -z "$key" || "$key" =~ ^# ]] && continue
    echo "  $key=<redacted>"
  done < "$file"
  set -a
  source "$file"
  set +a
}

if [[ -f "$ENV_FILE" ]]; then
  load_env "$ENV_FILE"
else
  echo "Warning: $ENV_FILE not found"
fi

if [[ -f "$LOCAL_FILE" ]]; then
  load_env "$LOCAL_FILE"
fi

# Joint-debug supplies a one-process remote override after loading the normal
# developer config. Deployment must use the same manifest remote as the tunnel.
if [[ -n "${JOINT_DEBUG_BACKEND_API_BASE_URL:-}" ]]; then
  if [[ ! "$JOINT_DEBUG_BACKEND_API_BASE_URL" =~ ^https://[A-Za-z0-9][A-Za-z0-9.-]*[A-Za-z0-9]$ ]]; then
    echo "ERROR: JOINT_DEBUG_BACKEND_API_BASE_URL must be an HTTPS origin." >&2
    exit 1
  fi
  case "${1:-}" in
    deploy|install|tunnel) export BACKEND_API_BASE_URL="$JOINT_DEBUG_BACKEND_API_BASE_URL" ;;
  esac
fi

# A development environment deployed with its own Connect key (so it can share
# a site with another environment of the same app). The manifest templates
# ${CONNECT_KEY}; dist/ must be built with the same key or every diagram read
# and write targets a type the install does not own. docs/reference/dev-connect-key.md
if [[ -n "${CONNECT_KEY_OVERRIDE:-}" ]]; then
  export CONNECT_KEY="$CONNECT_KEY_OVERRIDE"
fi
case "${1:-}" in
  deploy|tunnel)
    MARKER="$BASE_DIR/dist/connect-key-override.txt"
    if [[ -f "$MARKER" ]]; then
      BUILT_KEY="$(cat "$MARKER")"
      if [[ "$BUILT_KEY" != "${CONNECT_KEY_OVERRIDE:-}" ]]; then
        echo "ERROR: dist/ was built with CONNECT_KEY_OVERRIDE='${BUILT_KEY}' but this ${1} uses '${CONNECT_KEY_OVERRIDE:-}'." >&2
        echo "       Rebuild with the same value: CONNECT_KEY_OVERRIDE='${CONNECT_KEY_OVERRIDE:-}' pnpm build:<variant>" >&2
        exit 1
      fi
    fi
    ;;
esac

# Substitute {{VAR}} templates with env values
args=()
for arg in "$@"; do
  # Replace {{VAR}} patterns with their values
  while [[ "$arg" =~ \{\{([A-Za-z_][A-Za-z_0-9]*)\}\} ]]; do
    var_name="${BASH_REMATCH[1]}"
    var_value="${!var_name}"
    arg="${arg//\{\{$var_name\}\}/$var_value}"
  done
  args+=("$arg")
done

exec forge "${args[@]}"
