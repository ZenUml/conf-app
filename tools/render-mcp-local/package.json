{
  "name": "@zenuml/render-mcp",
  "version": "0.1.1",
  "description": "Local MCP server that draws ZenUML, Mermaid, PlantUML, draw.io, OpenAPI and AsyncAPI diagrams without sending their source to ZenUML.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZenUml/conf-app.git",
    "directory": "tools/render-mcp-local"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "zenuml-render-mcp": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "dependencies": {
    "@zenuml/core": "~4.13.1",
    "js-yaml": "^4.1.0",
    "linkedom": "^0.18.13",
    "mermaid": "^11.17.2"
  }
}
